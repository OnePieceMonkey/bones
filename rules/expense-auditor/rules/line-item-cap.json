{
  "id": "line-item-cap",
  "version": "1.0.0",
  "effect": "capping",
  "condition": {
    "kind": "comparison",
    "left": { "kind": "path", "segments": ["claimedTotalCents"] },
    "op": "!=",
    "right": { "kind": "path", "segments": ["lineItemSumCents"] }
  },
  "effectConfig": {
    "cap": {
      "kind": "sum",
      "collection": "lineItems",
      "field": "amount"
    },
    "scope": "total"
  },
  "messageTemplate": "Receipt total {{claimedTotalCents|money}} does not match line items {{lineItemSumCents|money}}. Capped to the line-item sum."
}
